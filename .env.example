# Lessons, animations, quizzes, SQL, and reference retrieval work without API credentials.
# Download the official Prometheus binaries with: python scripts/bootstrap.py
PROMETHEUS_URL=http://127.0.0.1:9098
# Optional generative tutor. Select a model available to your account.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional fine-tuned router endpoint (same chat-completions contract).
ROUTER_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=
# Optional local transformer embeddings + Chroma. Install .[embeddings] first.
EMBEDDING_MODEL=
# Optional LangSmith tracing; disabled by default. Treat chat traces as private.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=promql-zero-to-hero
# A hosted instance can use Streamlit OIDC; see docs/DEPLOYMENT.md.
REQUIRE_LOGIN=false
# Set only for the isolated Docker SQL runner.
SQL_RUNNER_URL=

